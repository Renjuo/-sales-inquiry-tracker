# Rahasia & konfigurasi per-server (lihat .env.example)
.env
.env.*
!.env.example

# Data bisnis & cadangan: jangan masuk repo
*.xlsx
*.xls
*.csv
~$*
*.bak
*.zip
*.rar
*.7z
