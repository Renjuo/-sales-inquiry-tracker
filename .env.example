# Contoh isi .env. Salin file ini menjadi ".env" lalu isi nilainya.
# File .env TIDAK boleh di-commit ke git dan tidak bisa diakses dari browser (.htaccess).

# JWT secret bersama dengan Portal Absensi (HS256). Harus sama persis dengan JWT_SECRET di .env portal.
# Buat nilai acak yang panjang, contoh: php -r "echo bin2hex(random_bytes(32));"
SSO_JWT_SECRET=

# Alamat Portal Absensi Staff. Kosongkan bila SSO tidak dipakai (login lokal).
PORTAL_ABSENSI_URL=

# Tujuan setelah Logout (default: https://erp.testindo.co.id/login)
# ERP_URL=

# Database
DB_HOST=localhost
DB_USER=
DB_PASS=
DB_NAME=
