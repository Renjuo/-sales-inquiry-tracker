RewriteEngine on
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule .* index.php/$0 [PT,L]

# Blokir akses langsung ke file rahasia (.env dan sejenisnya)
<FilesMatch "^\.env">
    Require all denied
</FilesMatch>

# Blokir file yang bukan untuk publik: file titik (.gitignore, .graphifyignore), dokumen internal,
# data Excel, dump SQL, dan cadangan
<FilesMatch "(^\.|\.(md|sql|xlsx?|csv|bak|zip|log|json\.bak)$)">
    Require all denied
</FilesMatch>

# Blokir folder perkakas & riwayat git bila ikut ter-upload (.git, .claude, .agents, .rtk, graphify-out)
RedirectMatch 404 "(^|/)(\.git|\.claude|\.agents|\.rtk|graphify-out)(/|$)"

# Di hosting, aktifkan baris ini supaya pesan error PHP tidak tampil ke pengunjung:
# SetEnv CI_ENV production

# ─── Gzip Compression ────────────────────────────────────────────────────────
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/css text/javascript application/javascript application/json
</IfModule>

# ─── Browser Caching (assets statis) ─────────────────────────────────────────
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType text/css                  "access plus 7 days"
    ExpiresByType application/javascript    "access plus 7 days"
    ExpiresByType image/png                 "access plus 30 days"
    ExpiresByType image/jpeg                "access plus 30 days"
    ExpiresByType image/gif                 "access plus 30 days"
    ExpiresByType image/svg+xml             "access plus 30 days"
    ExpiresByType image/x-icon              "access plus 30 days"
    ExpiresByType font/woff2                "access plus 30 days"
    ExpiresByType font/woff                 "access plus 30 days"
    ExpiresByType application/font-woff     "access plus 30 days"
</IfModule>

# ─── Keep-Alive ───────────────────────────────────────────────────────────────
<IfModule mod_headers.c>
    Header set Connection keep-alive
</IfModule>
